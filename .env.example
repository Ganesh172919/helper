# Copy to .env in this folder. Never commit .env or paste real keys into GitHub issues.
# Optional: Settings can save keys in OS credential storage instead (preferred).
# Stored OS credentials take precedence, then existing process variables, then .env.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
MAYA_COMPATIBLE_API_KEY=
# Bind this key to one compatible API base URL. Empty binds only to the default OpenAI endpoint.
MAYA_COMPATIBLE_BASE_URL=

# Optional private local data folder. Empty uses the normal per-user application folder.
MAYA_DATA_DIR=
